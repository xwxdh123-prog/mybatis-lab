<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.mapper.EmpMapper">
    <resultMap id="empResultMap" type="Emp">
        <id property="empId" column="emp_id"/>
        <result property="empName" column="emp_name"/>
        <result property="gender" column="gender"/>
        <result property="dept" column="dept"/>
        <result property="post" column="post"/>
        <result property="salary" column="salary"/>
        <result property="hireDate" column="hire_date"/>
        <result property="status" column="status"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="empColumns">
        emp_id, emp_name, gender, dept, post, salary,
        hire_date, status, email, phone, created_at
    </sql>

    <select id="selectAll" resultMap="empResultMap">
        SELECT <include refid="empColumns"/>
        FROM emp
        ORDER BY emp_id
    </select>

    <select id="selectById" parameterType="int" resultMap="empResultMap">
        SELECT <include refid="empColumns"/>
        FROM emp
        WHERE emp_id = #{empId}
    </select>

    <insert id="insert" parameterType="Emp"
            useGeneratedKeys="true" keyProperty="empId" keyColumn="emp_id">
        INSERT INTO emp (
            emp_name, gender, dept, post, salary,
            hire_date, status, email, phone
        )
        VALUES (
            #{empName}, #{gender}, #{dept}, #{post}, #{salary},
            #{hireDate}, #{status}, #{email}, #{phone}
        )
    </insert>

    <update id="update" parameterType="Emp">
        UPDATE emp
        SET emp_name = #{empName},
            gender = #{gender},
            dept = #{dept},
            post = #{post},
            salary = #{salary},
            hire_date = #{hireDate},
            status = #{status},
            email = #{email},
            phone = #{phone}
        WHERE emp_id = #{empId}
    </update>

    <delete id="deleteById" parameterType="int">
        DELETE FROM emp
        WHERE emp_id = #{empId}
    </delete>
</mapper>
