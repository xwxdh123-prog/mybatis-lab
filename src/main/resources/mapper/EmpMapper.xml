<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.mapper.EmpMapper">
    <resultMap id="empResultMap" type="Emp">
        <id property="empId" column="emp_id"/>
        <result property="empName" column="emp_name"/>
        <result property="gender" column="gender"/>
        <result property="dept" column="dept"/>
        <result property="post" column="post"/>
        <result property="salary" column="salary"/>
        <result property="hireDate" column="hire_date"/>
        <result property="status" column="status"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="empColumns">
        emp_id, emp_name, gender, dept, post, salary,
        hire_date, status, email, phone, created_at
    </sql>

    <select id="findAll" resultMap="empResultMap">
        SELECT <include refid="empColumns"/>
        FROM emp
        ORDER BY emp_id
    </select>

    <select id="findById" parameterType="int" resultMap="empResultMap">
        SELECT <include refid="empColumns"/>
        FROM emp
        WHERE emp_id = #{empId}
    </select>
</mapper>
